# =====================================================================
# Base de données
# =====================================================================
DATABASE_URL=

# =====================================================================
# Cloudinary (stockage des médias)
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
# =====================================================================
CLOUDINARY_URL=

# =====================================================================
# Serveur
# =====================================================================
PORT=3000
NODE_ENV=development

# Niveau de journalisation : fatal | error | warn | info | debug | trace | silent
# Vide = info en production, debug ailleurs.
LOG_LEVEL=

# =====================================================================
# Sécurité
# Générer chaque secret avec : openssl rand -base64 48
# Les deux secrets doivent être DIFFÉRENTS l'un de l'autre.
# =====================================================================
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
BCRYPT_SALT=10

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# =====================================================================
# CORS et URL publique
# =====================================================================
FRONT_URL=http://localhost:5173
CORS_ORIGINS=https://milnagourmet.com,https://www.milnagourmet.com

# Base des liens envoyés par email (réinitialisation de mot de passe).
# En production : https://milnagourmet.com
PUBLIC_APP_URL=http://localhost:8080

# =====================================================================
# NOTIFICATIONS — CANAL EMAIL (Resend)  ← canal actif par défaut
# ---------------------------------------------------------------------
# Les nouvelles commandes vendeur partent uniquement par email.
# La réinitialisation de mot de passe passe aussi toujours par email.
#
# Mise en place :
#   1. Créer un compte sur https://resend.com
#   2. Ajouter le domaine milnagourmet.com et valider les DNS (SPF/DKIM)
#   3. Créer une clé API Resend (format re_...) et la coller ci-dessous
#   4. MAIL_FROM doit utiliser le domaine vérifié
# =====================================================================
RESEND_API_KEY=
MAIL_FROM=Milna Gourmet <contact@milnagourmet.com>
VENDOR_EMAIL=business.libreville23@gmail.com

# =====================================================================
# NOTIFICATIONS — CANAL WHATSAPP (Telnyx)  ← à activer plus tard
# ---------------------------------------------------------------------
# Laisser VIDE tant que la configuration n'est pas faite sur le portail
# Telnyx : le système bascule automatiquement sur l'email.
#
# Les notifications client peuvent utiliser WhatsApp si TELNYX_API_KEY et
# TELNYX_WHATSAPP_FROM sont renseignés. Les nouvelles commandes vendeur
# restent envoyées par email.
#
# Rappel : hors d'une conversation ouverte depuis moins de 24 h, WhatsApp
# impose un « template » pré-approuvé. À configurer dans le portail
# Telnyx avant d'activer ce canal.
# =====================================================================
TELNYX_API_KEY=
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_WHATSAPP_FROM=            # numéro WhatsApp Business expéditeur (E.164)
TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_MESSAGE_TYPE=
VENDOR_WHATSAPP_NUMBER=          # destinataire vendeur, E.164 sans "whatsapp:"
