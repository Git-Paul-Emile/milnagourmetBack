# Database
DATABASE_URL=

# Cloudinary (stockage des médias) - format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Server
PORT=3000
NODE_ENV=development

# Security
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
BCRYPT_SALT=10

# Token Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
FRONT_URL=http://localhost:5173
CORS_ORIGINS=https://milnagourmet.com,https://www.milnagourmet.com

# Telnyx / WhatsApp (notifications de commande)
# Portail : https://portal.telnyx.com
TELNYX_API_KEY=
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_WHATSAPP_FROM=            # numéro WhatsApp Business expéditeur (E.164)
TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_MESSAGE_TYPE=
VENDOR_WHATSAPP_NUMBER=          # destinataire vendeur, E.164 sans "whatsapp:"